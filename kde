#!/bin/bash
set -e

# --- 1. PREP ---
clear
echo "==> ARCH INSTALL: KDE + LY (VERIFIED)"
read -p "Hostname: " HOSTNAME
read -p "Username: " USER
read -s -p "Password: " PASS
echo ""
DISK="/dev/vda"

# Sync databases so we find 'ly' in the extra repo
pacman -Sy --noconfirm archlinux-keyring

# --- 2. DISK ---
sgdisk --zap-all "$DISK"
sgdisk -n 1:0:+512M -t 1:ef00 "$DISK"
sgdisk -n 2:0:0 -t 2:8304 "$DISK"
P1="${DISK}1"; P2="${DISK}2"

mkfs.fat -F 32 "$P1"
mkfs.ext4 -F "$P2"
mount "$P2" /mnt
mount --mkdir "$P1" /mnt/boot

# --- 3. THE STACK ---
# Including every dependency Ly needs to actually launch a desktop
pacstrap -K /mnt base linux linux-firmware networkmanager sudo git \
bluez bluez-utils blueman pipewire pipewire-pulse pipewire-alsa pipewire-jack \
wireplumber plasma-pa plasma-desktop ly xorg-server xorg-xinit xorg-xauth \
konsole dolphin firefox xdg-user-dirs qemu-guest-agent

genfstab -U /mnt >> /mnt/etc/fstab

# --- 4. CHROOT ---
arch-chroot /mnt /bin/bash <<EOF
set -e
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
hwclock --systohc
echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=en_US.UTF-8" > /etc/locale.conf
echo "$HOSTNAME" > /etc/hostname

# Users
echo "root:$PASS" | chpasswd
useradd -m -G wheel "$USER"
echo "$USER:$PASS" | chpasswd
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/wheel

# Bootloader
bootctl install
UUID=\$(blkid -s PARTUUID -o value $P2)
echo "default arch" > /boot/loader/loader.conf
echo -e "title Arch Linux\nlinux /vmlinuz-linux\ninitrd /initramfs-linux.img\noptions root=PARTUUID=\$UUID rw" > /boot/loader/entries/arch.conf

# --- 5. ENABLING LY PROPERLY ---
# Disable the getty that usually hogs the screen
systemctl disable getty@tty1.service || true
# Force the display-manager symlink and enable the service
ln -sf /usr/lib/systemd/system/ly.service /etc/systemd/system/display-manager.service
systemctl enable ly.service

# Core Services
systemctl enable NetworkManager
systemctl enable bluetooth
systemctl enable qemu-guest-agent
EOF

# --- 6. EXIT ---
umount -R /mnt
echo "SUCCESS. REBOOTING TO LY TUI."
sleep 2
reboot
