#!/bin/bash
set -e

# --- 1. CONFIG ---
clear
echo "==> ARCH INSTALL: KDE + LY (FORCE MODE)"
read -p "Hostname: " HOSTNAME
read -p "Username: " USER
read -s -p "Password: " PASS
echo ""
DISK="/dev/vda"

# --- 2. PREP DISK ---
timedatectl set-ntp true
sgdisk --zap-all "$DISK"
sgdisk -n 1:0:+512M -t 1:ef00 "$DISK"
sgdisk -n 2:0:0 -t 2:8304 "$DISK"

P1="${DISK}1"; P2="${DISK}2"

mkfs.fat -F 32 "$P1"
mkfs.ext4 -F "$P2"
mount "$P2" /mnt
mount --mkdir "$P1" /mnt/boot

# --- 3. REFRESH MIRRORS & PACSTRAP ---
# This ensures pacstrap actually finds 'ly' and 'plasma'
pacman -Sy --noconfirm archlinux-keyring

echo "Installing Base + KDE + Ly..."
pacstrap -K /mnt base linux linux-firmware networkmanager sudo git \
bluez bluez-utils blueman pipewire pipewire-pulse pipewire-alsa pipewire-jack \
wireplumber plasma-pa plasma-desktop ly konsole dolphin firefox xdg-user-dirs qemu-guest-agent

genfstab -U /mnt >> /mnt/etc/fstab

# --- 4. SYSTEM CONFIG ---
arch-chroot /mnt /bin/bash <<EOF
set -e
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
hwclock --systohc
echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=en_US.UTF-8" > /etc/locale.conf
echo "$HOSTNAME" > /etc/hostname

# User Setup
echo "root:$PASS" | chpasswd
useradd -m -G wheel "$USER"
echo "$USER:$PASS" | chpasswd
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/wheel

# Bootloader
bootctl install
UUID=\$(blkid -s PARTUUID -o value $P2)
echo "default arch" > /boot/loader/loader.conf
echo -e "title Arch Linux\nlinux /vmlinuz-linux\ninitrd /initramfs-linux.img\noptions root=PARTUUID=\$UUID rw" > /boot/loader/entries/arch.conf

# --- 5. THE SERVICES (THE FIX) ---
# We run a check to see if Ly actually installed
if [ -f /usr/lib/systemd/system/ly.service ]; then
    systemctl enable ly.service
else
    echo "ERROR: Ly was not installed correctly. Forcing install inside chroot..."
    pacman -S --noconfirm ly
    systemctl enable ly.service
fi

systemctl enable NetworkManager
systemctl enable bluetooth
systemctl enable qemu-guest-agent
EOF

# --- 6. FINISH ---
umount -R /mnt
echo "DONE. If you don't see a login box after reboot, something is blocking Ly."
sleep 2
reboot
